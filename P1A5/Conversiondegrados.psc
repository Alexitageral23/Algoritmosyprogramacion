// Realizar un algoritmo en pseudocódigo para convertir grados Celsius a Kelvin y Fahrenheit
// Calcule e imprima la conversión de grados Celcius a Kelvin y Fahrenheit
Algoritmo Conversiondegrados
	Definir Celsius, Kelvin, Fahrenheit Como Real
	Escribir 'Ingresa la temperatura en grados Celsius: '
	Leer Celsius
	Kelvin <- Celsius+273.15
	Fahrenheit <- (Celsius*9/5)+32
	Escribir 'La temperatura en Kelvin es:', Kelvin
	Escribir 'La temperatura en Fahrenheit es:', Fahrenheit
FinAlgoritmo
