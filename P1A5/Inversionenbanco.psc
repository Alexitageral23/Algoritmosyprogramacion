// Realizar un algoritmo en pseudocódigo para saber cuánto dinero ganará una persona después de un mes con la razón del 2 MOD  mensual
// Calcule e imprima la cantidad de dinero que la persona ganará en un mes
Algoritmo Inversionenbanco
	Definir capital, ganancia, total Como Real
	Escribir 'Ingresa el capital invertido:'
	Leer capital
	ganancia <- capital*0.2
	total <- ganancia+capital
	Escribir 'La ganancia en un mes es de: $', ganancia
	Escribir 'El total que tendría en un mes es de: $', total
FinAlgoritmo
